@article{CORLESS1998757,
title = {State and Input Estimation for a Class of Uncertain Systems},
journal = {Automatica},
volume = {34},
number = {6},
pages = {757-764},
year = {1998},
issn = {0005-1098},
doi = {https://doi.org/10.1016/S0005-1098(98)00013-2},
url = {https://www.sciencedirect.com/science/article/pii/S0005109898000132},
author = {MARTIN CORLESS and JAY TU},
keywords = {State estimation, disturbance estimation, observers, Lyapunov, linear matrix inequalities, uncertain systems},
abstract = {We consider here the problem of state and input estimation for a class of uncertain systems which consist of a nominally linear part and an uncertain/nonlinear/time-varying part which can be regarded as a state-dependent/time-varying input. We obtain a Lyapunov-type characterization of the assumptions commonly found in the literature on this problem. Using this characterization, we obtain estimators which, using only a measured output, can asymptotically estimate to any desired accuracy the system state and the input.}
}

